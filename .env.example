# Copiar a .env y cambiar la contraseña. .env no se sube al repositorio.
POSTGRES_DB=lazystudio
POSTGRES_USER=lazystudio
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_PORT=5432

# IA gratuita (porción 3). Vacía = ese proveedor no se usa.
